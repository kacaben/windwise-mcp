{
  "name": "windwise-mcp",
  "version": "0.1.0",
  "description": "An MCP server that gives AI agents wind, weather and marine forecasts from Open-Meteo, with tools for finding rideable wind windows.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "open-meteo",
    "weather",
    "wind",
    "marine",
    "kitesurfing",
    "wing-foiling",
    "dinghy-sailing",
    "ai-agents"
  ],
  "author": "Kateřina Beňová",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kacaben/windwise-mcp.git"
  },
  "homepage": "https://github.com/kacaben/windwise-mcp#readme",
  "bugs": {
    "url": "https://github.com/kacaben/windwise-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "windwise-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}
